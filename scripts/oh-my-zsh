# oh-my-zsh, cloned to ~/.oh-my-zsh by install.sh. Skipped when it is not
# there, so a machine without it still gets a working shell.
#
# .zshrc sources this file before the loop over ~/scripts, and the loop skips
# it: oh-my-zsh's aliases and options have to lose to the files here.
ZSH="${ZSH:-$HOME/.oh-my-zsh}"

if [[ -r "$ZSH/oh-my-zsh.sh" ]]; then
  # scripts/git owns $PROMPT.
  ZSH_THEME=""
  # No git plugin: scripts/github owns the git aliases.
  plugins=(brew docker gh)
  # The default mode asks before updating, on the first prompt of a new shell.
  zstyle ':omz:update' mode reminder

  # oh-my-zsh runs compinit itself, and drops its dump in $HOME when this is
  # unset. The same path scripts/completion uses, so there is only one dump.
  ZSH_COMPDUMP="${ZSH_COMPDUMP:-${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump-${ZSH_VERSION}}"
  mkdir -p "${ZSH_COMPDUMP:h}"
  zmodload zsh/complist

  # The stock plugins return non-zero when the tool they wrap is missing, and
  # the profile is sourced under errexit.
  source "$ZSH/oh-my-zsh.sh" || true
fi
