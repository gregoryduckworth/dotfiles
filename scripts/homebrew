# Homebrew's curl ahead of the system one. $HOMEBREW_PREFIX first, as
# scripts/nvm and scripts/zsh-plugins do, then the Apple Silicon and Intel
# prefixes. Only prepended once, so re-sourcing the profile (`sz`) does not
# keep growing $PATH.
for curl_bin in \
  ${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX/opt/curl/bin"} \
  /opt/homebrew/opt/curl/bin \
  /usr/local/opt/curl/bin; do
  if [[ -d "$curl_bin" ]]; then
    if [[ ":$PATH:" != *":$curl_bin:"* ]]; then
      export PATH="$curl_bin:$PATH"
    fi
    break
  fi
done
unset curl_bin
