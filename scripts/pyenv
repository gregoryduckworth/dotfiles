# Python
# ~/.pyenv/bin only exists for a git-clone install; the Homebrew formula is
# already on $PATH. Prepended only when it exists, and only once, the same way
# scripts/rbenv does it.
if [[ -d "$HOME/.pyenv/bin" && ":$PATH:" != *":$HOME/.pyenv/bin:"* ]]; then
  export PATH="$HOME/.pyenv/bin:$PATH"
fi
# --no-rehash keeps shell startup quick, and keeps the rehash - which fails
# when no version is installed yet - from aborting a profile sourced under
# errexit.
if command -v pyenv > /dev/null; then eval "$(pyenv init --no-rehash - zsh)"; fi
