# Machine-specific settings and secrets. The real file lives at ~/.zshrc.local
# and is sourced last by .zshrc; ignoring it here keeps a copy made inside the
# checkout from ever being committed.
.zshrc.local
.env

# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editor leftovers
*.swp
*.swo
*~

# A literal `~` directory, created by an unquoted tilde that was meant to
# expand to $HOME. One got committed once already (see issue #10).
~/
